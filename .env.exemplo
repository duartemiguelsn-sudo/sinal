# Copia este ficheiro para .env e mete as chaves lá dentro.
#
#     copy .env.exemplo .env
#
# O .env está no .gitignore: nunca vai para o repositório nem para o site.
# Este ficheiro, o .env.exemplo, vai — por isso nunca metas aqui nada a sério.
#
# Isto é só para correres o pipeline na tua máquina. No GitHub Action a chave
# vem de um Secret do repositório, e o .env nem sequer lá existe.

# A chave da Anthropic, que paga as fases 2, 3 e 4.
# Sem ela o pipeline recolhe na mesma e publica os itens sem nota.
# Tira-a em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional. Um token do GitHub sobe o limite da pesquisa da fase 3 de 10 para
# 30 pedidos por minuto. Chega um token clássico sem permissão nenhuma marcada.
# Tira-o em https://github.com/settings/tokens
GITHUB_TOKEN=

# Notificações. Gera o par com: python pipeline/notificar.py --gerar-chaves
# A privada vai para o Secret VAPID_CHAVE_PRIVADA; a pública vai no app.js.
VAPID_CHAVE_PRIVADA=

# A linha copiada do rodapé do site, num aparelho. Aqui cabe só uma, porque o
# .env é uma linha por chave; no Secret do GitHub põe-se uma por aparelho.
# Localmente só serve para o --teste.
PUSH_SUBSCRICOES=
